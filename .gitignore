# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Cloudflare (développement local)
.wrangler
.dev.vars

# Photos et exports marketing (lourds, gardés hors de git)
marketing/album/
marketing/produits/
marketing/vitrine/
marketing/affiche/photos/
marketing/affiche/*.png
marketing/affiche/*.jpg
