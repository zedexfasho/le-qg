{
  "name": "le-qg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "brand": "tsx scripts/generate-brand.ts",
    "placeholders": "tsx scripts/generate-placeholders.ts",
    "deploy": "npm run catalog:pull && npm run build && wrangler d1 migrations apply le-qg-db --remote && wrangler deploy",
    "catalog:pull": "tsx scripts/catalog-pull.ts",
    "db:migrate": "wrangler d1 migrations apply le-qg-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply le-qg-db --local",
    "db:seed": "tsx scripts/catalog-seed.ts --remote",
    "db:seed:local": "tsx scripts/catalog-seed.ts --local",
    "admin:create": "tsx scripts/create-admin.ts",
    "dev:api": "wrangler dev --port 8787",
    "import:photos": "tsx scripts/import-photos.ts"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
